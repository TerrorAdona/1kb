import { useEffect, useRef, useState } from "react";
import type { ReactNode } from "react";
import {
  ArrowLeft,
  ArrowRight,
  Clock3,
  Flag,
  Gauge,
  History,
  Info,
  Radio,
  ShieldCheck,
  Sparkles,
  Trash2,
  Trophy,
} from "lucide-react";
import { Link, useLocation, useNavigate, useParams } from "react-router-dom";
import { getGame, playSoloAction } from "../games/gameApi";
import type { Game } from "../../shared/types/api";
import type { CardType } from "../../shared/types/game";
import { apiErrorMessage } from "../../shared/api/errors";
import { useAuthStore } from "../auth/authStore";
import { useGameSocket } from "../games/useLobbySocket";
import { Button, ButtonLink } from "../../shared/components/Button";
import { GameCard } from "../../shared/components/GameCard";
import { Notice } from "../../shared/components/Notice";
import type {
  EngineCard,
  GameSnapshot,
  LiveGameEvent,
  LiveGameState,
  VisiblePlayerState,
} from "../../shared/types/realtime";

const previewCards: CardType[] = [
  "km_25",
  "km_50",
  "km_75",
  "km_100",
  "red_light",
  "repairs",
];

const previewOpponents = [
  { name: "Camille", distance: 450, danger: "Limite de vitesse" },
  { name: "Alex", distance: 275, danger: "Feu vert" },
];

const previewHistory = [
  { who: "Vous", what: "avez pose une borne", when: "À l’instant" },
  { who: "Camille", what: "a recu une limitation", when: "Il y a 1 min" },
  { who: "Alex", what: "a parcouru 50 km", when: "Il y a 2 min" },
];

export function GamePage() {
  const { gameId = "" } = useParams();
  const location = useLocation();
  const navigate = useNavigate();
  const user = useAuthStore((state) => state.user);
  const [game, setGame] = useState<Game | null>(
    (location.state as { game?: Game } | null)?.game ?? null,
  );
  const [loading, setLoading] = useState(gameId !== "demo");
  const [error, setError] = useState("");
  const [selectedCard, setSelectedCard] = useState<CardType | null>(null);
  const [notice, setNotice] = useState("");

  useEffect(() => {
    if (gameId === "demo") {
      setLoading(false);
      return;
    }
    let active = true;
    getGame(gameId)
      .then((data) => {
        if (active) setGame(data);
      })
      .catch((cause: unknown) => {
        if (active) setError(apiErrorMessage(cause, "Impossible de charger la partie."));
      })
      .finally(() => {
        if (active) setLoading(false);
      });
    return () => {
      active = false;
    };
  }, [gameId]);

  if (loading) return <div className="grid min-h-[55vh] place-items-center"><span className="loading-dot" /></div>;
  if (error && !game) {
    return (
      <div className="mx-auto max-w-2xl py-8">
        <Notice tone="error">{error}</Notice>
        <ButtonLink to="/lobby" variant="outline" className="mt-5">Retour aux salons</ButtonLink>
      </div>
    );
  }

  if (game?.mode === "multiplayer") {
    return <LiveMultiplayerGame game={game} />;
  }

  if (game?.mode === "solo") {
    return <LiveSoloGame game={game} />;
  }

  const gameTitle = game?.mode === "solo" ? "Course en solo" : "Course multijoueur";
  const playerName = user?.display_name ?? "Vous";
  const apiOpponents = game?.participants.filter(
    (participant) => participant.kind === "human" && participant.display_name !== playerName,
  ) ?? [];

  return (
    <div className="page-enter">
      <div className="mb-5 flex flex-wrap items-center justify-between gap-3">
        <Link to="/lobby" className="inline-flex items-center gap-2 text-sm font-bold text-stone-600 hover:text-forest">
          <ArrowLeft size={16} /> Quitter le plateau
        </Link>
        <span className="flex items-center gap-2 rounded-full border border-orange-200 bg-orange-50 px-3 py-1.5 text-[10px] font-extrabold uppercase tracking-[.12em] text-orange-800">
          <Radio size={13} /> Apercu du plateau
        </span>
      </div>

      <div className="game-preview-warning">
        <Info size={17} className="shrink-0" />
        <p>
          <strong>Les commandes de partie ne sont pas encore exposees par l’API.</strong>{" "}
          Les cartes, kilometres et evenements ci-dessous sont illustratifs. Aucun coup n’est joue ni regle calculee dans le navigateur.
        </p>
      </div>
      {error && <div className="mt-4"><Notice tone="error">{error}</Notice></div>}
      {notice && <div className="mt-4"><Notice>{notice}</Notice></div>}

      <div className="game-table">
        <header className="game-topbar">
          <div className="flex min-w-0 items-center gap-3">
            <span className="grid size-10 shrink-0 place-items-center rounded-2xl bg-white/10 text-orange-300"><Flag size={18} /></span>
            <span className="min-w-0">
              <strong className="block truncate font-display text-lg font-extrabold text-cream">{gameTitle}</strong>
              <small className="text-xs text-cream/50">{game?.id ? `Salle ${game.id.slice(0, 8)}` : "Course de demonstration"}</small>
            </span>
          </div>
          <div className="game-turn-pill"><span className="turn-pulse" /> Votre tour <span className="hidden sm:inline">· Apercu</span></div>
          <span className="hidden items-center gap-2 text-xs text-cream/55 sm:flex"><Clock3 size={14} /> 00:42</span>
        </header>

        <section className="opponent-board" aria-label="État illustratif des adversaires">
          {previewOpponents.slice(0, Math.max(1, game?.participants.length ?? 2) - 1).map((opponent, index) => (
            <article className="opponent-board-card" key={opponent.name}>
              <div className="flex items-center gap-3">
                <span className={`opponent-avatar opponent-avatar-${index}`}>{opponent.name.slice(0, 1)}</span>
                <span className="min-w-0">
                  <strong className="block truncate text-sm text-cream">{apiOpponents[index]?.display_name ?? opponent.name}</strong>
                  <small className="text-[10px] text-cream/45">{opponent.danger}</small>
                </span>
              </div>
              <div className="opponent-km"><strong>{opponent.distance}</strong><span>km</span></div>
              <div className="mt-3 flex items-center justify-between gap-2">
                <div className="flex -space-x-5">
                  {[0, 1, 2, 3].map((index) => (
                    <GameCard key={index} back size="small" className="scale-[.62] origin-top-left -mr-7" />
                  ))}
                </div>
                <span className="text-[9px] font-bold uppercase tracking-wider text-cream/40">Main cachee</span>
              </div>
            </article>
          ))}
          <div className="opponent-note">
            <span className="grid size-8 place-items-center rounded-xl bg-white/8 text-orange-300"><Sparkles size={15} /></span>
            <span><strong>Le peloton</strong><small>Illustration uniquement</small></span>
          </div>
        </section>

        <section className="road-board" aria-label="Piste de course illustrative">
          <div className="road-board-top">
            <span className="flex items-center gap-2 text-xs font-bold uppercase tracking-[.14em] text-cream/55"><Gauge size={15} /> La route</span>
            <span className="text-xs font-semibold text-cream/45">Objectif illustratif · 1 000 km</span>
          </div>
          <div className="road-progress-wrap">
            <div className="road-progress-label">
              <span>{playerName}</span>
              <strong>325 <small>km</small></strong>
            </div>
            <div className="road-track">
              <span className="road-track-fill" style={{ width: "32.5%" }} />
              <span className="road-car-marker" style={{ left: "32.5%" }}>🚙</span>
              <span className="road-finish-marker"><Flag size={13} /> 1 000</span>
            </div>
            <div className="road-ticks"><span>0 km</span><span>500 km</span><span>1 000 km</span></div>
          </div>
          <div className="road-boards">
            <BattleBoard title="Votre route" icon={<ShieldCheck size={15} />} status="Feu vert" tone="good" />
            <BattleBoard title="Limitation" icon={<Gauge size={15} />} status="Libre" tone="neutral" />
            <BattleBoard title="Bottes actives" icon={<Sparkles size={15} />} status="Aucune" tone="neutral" />
          </div>
        </section>

        <section className="game-bottom">
          <div className="game-hand-panel">
            <div className="flex flex-wrap items-center justify-between gap-3">
              <div>
                <p className="eyebrow text-cream/45">Votre main</p>
                <h2 className="mt-1 font-display text-lg font-extrabold text-cream">Choisissez votre carte</h2>
              </div>
              <span className="rounded-full bg-white/8 px-3 py-1 text-[10px] font-bold text-cream/55">6 cartes · exemple</span>
            </div>
            <div className="game-hand">
              {previewCards.map((type, index) => (
                <GameCard
                  key={`${type}-${index}`}
                  type={type}
                  selected={selectedCard === type}
                  onClick={() => {
                    setSelectedCard(type);
                    setNotice("Selection visuelle uniquement : l’API de jeu ne permet pas encore de jouer une carte.");
                  }}
                />
              ))}
            </div>
            <div className="mt-5 flex flex-wrap items-center gap-3">
              <Button
                onClick={() => setNotice("L’action « jouer » sera activee lorsque l’API de commandes de jeu sera disponible.")}
                disabled={!selectedCard}
              >
                Jouer la carte <ArrowRight size={16} />
              </Button>
              <Button
                variant="outline"
                className="border-white/15 bg-white/5 text-cream hover:bg-white/10"
                onClick={() => setNotice("La defausse est desactivee en apercu : le moteur serveur doit valider cette action.")}
              >
                <Trash2 size={15} /> Defausser
              </Button>
            </div>
          </div>
          <aside className="game-log-panel">
            <div className="flex items-center justify-between">
              <span className="flex items-center gap-2 text-sm font-extrabold text-cream"><History size={16} /> Actions recentes</span>
              <span className="text-[9px] font-bold uppercase tracking-wider text-cream/35">Apercu</span>
            </div>
            <ol className="mt-4 space-y-4">
              {previewHistory.map((item, index) => (
                <li className="game-log-item" key={`${item.who}-${index}`}>
                  <span className={`game-log-dot ${index === 0 ? "active" : ""}`} />
                  <span><strong>{item.who}</strong> {item.what}<small>{item.when}</small></span>
                </li>
              ))}
            </ol>
            <div className="mt-5 border-t border-white/10 pt-4">
              <ButtonLink to="/profile" variant="quiet" size="sm" className="text-cream/70 hover:bg-white/8 hover:text-cream">
                <Trophy size={14} /> Voir mon parcours
              </ButtonLink>
            </div>
          </aside>
        </section>
      </div>
      {game?.status === "finished" && (
        <div className="mt-6 text-center">
          <Button onClick={() => navigate(`/result/${game.id}`)}>Voir le resultat</Button>
        </div>
      )}
      <p className="mt-4 text-center text-[10px] text-stone-500">
        Donnees de plateau temporaires utilisees uniquement parce que l’API de jeu n’est pas encore disponible.
      </p>
    </div>
  );
}

function LiveSoloGame({ game }: { game: Game }) {
  const navigate = useNavigate();
  const [snapshot, setSnapshot] = useState<GameSnapshot | null>(null);
  const [selectedCardId, setSelectedCardId] = useState("");
  const [selectedTargetId, setSelectedTargetId] = useState("");
  const [message, setMessage] = useState("");
  const [isActing, setIsActing] = useState(false);
  const [turnNotification, setTurnNotification] = useState<{ show: boolean; message: string } | null>(null);
  const wasMyTurnRef = useRef(false);

  useEffect(() => {
    const loadSnapshot = async () => {
      try {
        const data = await getGame(game.id);
        setSnapshot({
          game: data,
          state: null,
          events: [],
          presence: {},
        });
      } catch (cause) {
        setMessage(apiErrorMessage(cause, "Impossible de charger l'etat de la partie."));
      }
    };
    loadSnapshot();
  }, [game.id]);

  useEffect(() => {
    if (!snapshot?.game) return;
    getGame(snapshot.game.id)
      .then((data) => {
        setSnapshot((current) =>
          current
            ? { ...current, game: data }
            : { game: data, state: null, events: [], presence: {} },
        );
      })
      .catch(() => {});
  }, [snapshot?.game?.id]);

  // Detect turn changes and show notification
  useEffect(() => {
    if (!state) return;
    const isMyTurn = state.active_player_id === state.viewer_player_id && state.phase !== "finished";
    if (isMyTurn && !wasMyTurnRef.current) {
      // Turn just changed to me
      setTurnNotification({
        show: true,
        message: state.phase === "draw" ? "À vous de piocher !" : state.can_pass ? "Repondez a l'attaque !" : "À vous de jouer !"
      });
      // Auto-hide after 4 seconds
      setTimeout(() => setTurnNotification(null), 4000);
    }
    wasMyTurnRef.current = isMyTurn;
  }, [state?.active_player_id, state?.phase, state?.can_pass]);

  const state = snapshot?.state ?? null;
  const self = state?.players.find(
    (player) => player.player_id === state.viewer_player_id,
  );
  const opponents =
    state?.players.filter(
      (player) => player.player_id !== state.viewer_player_id,
    ) ?? [];
  const selectedPlays =
    state?.legal_actions.filter(
      (action) => action.card_id === selectedCardId,
    ) ?? [];
  const targetOptions = selectedPlays.filter(
    (action) => action.target_player_id !== null,
  );
  const selectedPlay =
    selectedPlays.find(
      (action) => action.target_player_id === selectedTargetId,
    ) ??
    selectedPlays.find((action) => action.target_player_id === null) ??
    (selectedPlays.length === 1 ? selectedPlays[0] : undefined);

  async function sendAction(action: string, extra: Record<string, unknown> = {}) {
    if (!snapshot?.game) return;
    setIsActing(true);
    try {
      const response = await playSoloAction(snapshot.game.id, {
        action,
        ...extra,
        state_version: snapshot.game.state_version,
        request_id: crypto.randomUUID(),
      });
      setMessage("");
      setSnapshot((current) =>
        current
          ? { ...current, game: response.game, state_version: response.state_version }
          : null,
      );
      // Reload to get updated state with bot turns
      const refreshed = await getGame(snapshot.game.id);
      setSnapshot((current) =>
        current ? { ...current, game: refreshed } : null,
      );
    } catch (cause) {
      setMessage(apiErrorMessage(cause, "La commande n'a pas pu etre executee."));
    } finally {
      setIsActing(false);
    }
  }

  function playSelectedCard() {
    if (!selectedCardId || !selectedPlay) {
      setMessage(
        targetOptions.length > 1
          ? "Choisissez un adversaire a cibler."
          : "Cette carte n'est pas jouable dans l'etat actuel.",
      );
      return;
    }
    sendAction("play", {
      card_id: selectedCardId,
      ...(selectedPlay.target_player_id
        ? { target_player_id: selectedPlay.target_player_id }
        : {}),
    });
    setSelectedCardId("");
    setSelectedTargetId("");
  }

  function discardSelectedCard() {
    if (!selectedCardId) {
      setMessage("Selectionnez une carte a defausser.");
      return;
    }
    sendAction("discard", { card_id: selectedCardId });
    setSelectedCardId("");
  }

  function abandonGame() {
    if (!window.confirm("Abandonner cette partie ? La course sera annulee.")) {
      return;
    }
    sendAction("abandon", {});
  }

  if (!state) {
    return (
      <div className="mx-auto max-w-3xl py-8">
        <div className="game-preview-warning">
          <Radio size={17} className="shrink-0" />
          <p>
            {snapshot?.game?.status === "active"
              ? "Chargement de la partie en cours…"
              : "Partie non disponible."}
          </p>
        </div>
        {message && <div className="mt-4"><Notice tone="error">{message}</Notice></div>}
      </div>
    );
  }

  const currentStatus =
    game.status === "finished"
      ? "Partie terminee"
      : game.status === "cancelled"
        ? "Partie annulee"
        : state.can_pass
          ? "À vous de repondre"
          : state.active_player_id === state.viewer_player_id
            ? state.phase === "draw"
              ? "À vous de piocher"
              : "À vous de jouer"
            : `Tour de l'adversaire (IA)`;

  const isMyTurn = state && state.active_player_id === state.viewer_player_id && state.phase !== "finished";

  return (
    <div className="page-enter">
      {/* Turn change notification toast */}
      {turnNotification && (
        <div className="turn-change-toast" role="alert" aria-live="polite">
          <span className="turn-change-toast-icon">
            <Radio size={14} />
          </span>
          <span>{turnNotification.message}</span>
        </div>
      )}

      <div className="page-enter">
        <div className="mb-5 flex flex-wrap items-center justify-between gap-3">
          <ButtonLink to="/lobby" variant="quiet" className="text-forest">
            <ArrowLeft size={16} /> Retour au lobby
          </ButtonLink>
          <div className="flex items-center gap-3">
            <span className="socket-pill socket-connected">
              <Radio size={14} />
              Partie solo
            </span>
            {isMyTurn && (
              <span className="my-turn-badge">Votre tour</span>
            )}
          </div>
        </div>

      {message && <div className="mb-4"><Notice tone="error">{message}</Notice></div>}
      {game.status === "cancelled" && (
        <div className="mb-4">
          <Notice>La partie a ete annulee. L'etat reste consultable.</Notice>
        </div>
      )}

      <div className="game-table">
        <header className="game-topbar">
          <div className="flex min-w-0 items-center gap-3">
            <span className="grid size-10 shrink-0 place-items-center rounded-2xl bg-white/10 text-orange-300">
              <Flag size={18} />
            </span>
            <span className="min-w-0">
              <strong className="block truncate font-display text-lg font-extrabold text-cream">
                Mille Bornes · Solo
              </strong>
              <small className="text-xs text-cream/50">
                Tour {state.turn_number} · {state.draw_pile_count} cartes dans la pioche
              </small>
            </span>
          </div>
          <div className="game-turn-pill">
            <span className="turn-pulse" /> {currentStatus}
          </div>
          {game.status === "active" && (
            <Button
              variant="quiet"
              size="sm"
              className="text-cream/65 hover:bg-white/10 hover:text-cream"
              onClick={abandonGame}
              disabled={isActing}
            >
              Abandonner
            </Button>
          )}
        </header>

        <section className="opponent-board" aria-label="État visible des adversaires">
          {opponents.map((opponent, index) => (
            <OpponentBoardCard
              key={opponent.player_id}
              player={opponent}
              index={index}
              online={true}
              active={opponent.player_id === state.active_player_id}
            />
          ))}
          <div className="opponent-note">
            <span className="grid size-8 place-items-center rounded-xl bg-white/8 text-orange-300">
              <Sparkles size={15} />
            </span>
            <span>
              <strong>Adversaires IA</strong>
              <small>Le serveur joue automatiquement leurs tours</small>
            </span>
          </div>
        </section>

        <section className="road-board" aria-label="État de la course">
          <div className="road-board-top">
            <span className="flex items-center gap-2 text-xs font-bold uppercase tracking-[.14em] text-cream/55">
              <Gauge size={15} /> La route
            </span>
            <span className="text-xs font-semibold text-cream/45">
              Objectif · {state.target_distance.toLocaleString("fr-FR")} km
            </span>
          </div>
          <div className="road-progress-wrap">
            <div className="road-progress-label">
              <span>{self?.display_name ?? "Vous"}</span>
              <strong>{self?.distance ?? 0} <small>km</small></strong>
            </div>
            <div className="road-track">
              <span
                className="road-track-fill"
                style={{
                  width: `${Math.min(
                    100,
                    ((self?.distance ?? 0) / state.target_distance) * 100,
                  )}%`,
                }}
              />
              <span
                className="road-car-marker"
                style={{
                  left: `${Math.min(
                    97,
                    ((self?.distance ?? 0) / state.target_distance) * 100,
                  )}%`,
                }}
              >
                🚙
              </span>
              <span className="road-finish-marker">
                <Flag size={13} /> {state.target_distance}
              </span>
            </div>
            <div className="road-ticks">
              <span>0 km</span>
              <span>{Math.round(state.target_distance / 2)} km</span>
              <span>{state.target_distance} km</span>
            </div>
          </div>
          <div className="road-boards">
            <BattleBoard
              title="Votre route"
              icon={<ShieldCheck size={15} />}
              status={self?.green_light_card ? "Feu vert" : "À l'arret"}
              tone={self?.green_light_card ? "good" : "neutral"}
              card={self?.green_light_card}
            />
            <BattleBoard
              title="Danger actif"
              icon={<Gauge size={15} />}
              status={
                self?.battle_attack
                  ? cardLabel(self.battle_attack.card_type)
                  : self?.speed_attack
                    ? cardLabel(self.speed_attack.card_type)
                    : "Aucun"
              }
              tone={self?.battle_attack || self?.speed_attack ? "neutral" : "good"}
              card={self?.battle_attack ?? self?.speed_attack}
            />
            <BattleBoard
              title="Bottes actives"
              icon={<Sparkles size={15} />}
              status={self?.safeties.length ? self.safeties.map(cardLabel).join(" · ") : "Aucune"}
              tone={self?.safeties.length ? "good" : "neutral"}
            />
          </div>
          <div className="mt-3 flex flex-wrap items-center gap-2">
            <span className="text-[9px] font-bold uppercase tracking-wider text-cream/40">
              Bornes posees
            </span>
            {self?.distance_cards.map((card) => (
              <GameCard
                key={card.id}
                type={card.card_type}
                size="small"
                className="scale-[.55] origin-left -mr-8"
              />
            ))}
            {state.discard_top && (
              <>
                <span className="ml-auto text-[9px] font-bold uppercase tracking-wider text-cream/40">
                  Defausse
                </span>
                <GameCard type={state.discard_top.card_type} size="small" className="scale-[.55] origin-right -mr-8" />
              </>
            )}
          </div>
        </section>

        <section className="game-bottom">
          <div className="game-hand-panel">
            <div className="flex flex-wrap items-center justify-between gap-3">
              <div>
                <p className="eyebrow text-cream/45">Votre main</p>
                <h2 className="mt-1 font-display text-lg font-extrabold text-cream">
                  {state.can_draw
                    ? "Piochez pour commencer votre tour"
                    : state.can_pass
                      ? "Repondez a l'attaque"
                      : "Choisissez une carte"}
                </h2>
              </div>
              <span className="rounded-full bg-white/8 px-3 py-1 text-[10px] font-bold text-cream/55">
                {state.hand.length} cartes
              </span>
            </div>
            <div className="game-hand">
              {state.hand.map((card) => {
                const playable = state.legal_actions.some(
                  (action) => action.card_id === card.id,
                );
                const isPlayableNow = isMyTurn && playable;
                return (
                  <GameCard
                    key={card.id}
                    type={card.card_type}
                    selected={selectedCardId === card.id}
                    disabled={!playable && !state.can_discard}
                    className={isPlayableNow ? "playable-card-highlight" : undefined}
                    onClick={() => {
                      setSelectedCardId(card.id);
                      setSelectedTargetId("");
                      setMessage("");
                    }}
                  />
                );
              })}
            </div>
            {targetOptions.length > 0 && (
              <label className="mt-4 flex flex-wrap items-center gap-3 text-xs font-bold text-cream/70">
                Cible de l'attaque
                <select
                  className="rounded-xl border border-white/15 bg-forest-950 px-3 py-2 text-sm text-cream"
                  value={selectedTargetId}
                  onChange={(event) => setSelectedTargetId(event.target.value)}
                >
                  <option value="">Choisir un joueur</option>
                  {targetOptions.map((action) => {
                    const target = state.players.find(
                      (player) => player.player_id === action.target_player_id,
                    );
                    return (
                      <option key={action.target_player_id} value={action.target_player_id ?? ""}>
                        {target?.display_name ?? "Adversaire"}
                      </option>
                    );
                  })}
                </select>
              </label>
            )}
            <div className="mt-5 flex flex-wrap items-center gap-3">
              {state.can_draw && (
                <Button disabled={isActing} onClick={() => sendAction("draw")}>
                  Piocher
                </Button>
              )}
              <Button
                disabled={isActing || !selectedPlay}
                onClick={playSelectedCard}
              >
                Jouer la carte <ArrowRight size={16} />
              </Button>
              {state.can_discard && (
                <Button
                  variant="outline"
                  className="border-white/15 bg-white/5 text-cream hover:bg-white/10"
                  disabled={isActing || !selectedCardId}
                  onClick={discardSelectedCard}
                >
                  <Trash2 size={15} /> Defausser
                </Button>
              )}
              {state.can_pass && (
                <Button
                  variant="outline"
                  className="border-white/15 bg-white/5 text-cream hover:bg-white/10"
                  disabled={isActing}
                  onClick={() => sendAction("pass")}
                >
                  Passer
                </Button>
              )}
            </div>
          </div>
          <aside className="game-log-panel">
            <div className="flex items-center justify-between">
              <span className="flex items-center gap-2 text-sm font-extrabold text-cream">
                <History size={16} /> Actions recentes
              </span>
              <span className="text-[9px] font-bold uppercase tracking-wider text-cream/35">
                En direct
              </span>
            </div>
            <ol className="mt-4 space-y-4">
              {[...(snapshot?.events ?? [])].reverse().slice(0, 8).map((event) => (
                <li className="game-log-item" key={event.id}>
                  <span className={`game-log-dot ${event.event_type === "game.action" ? "active" : ""}`} />
                  <span>
                    {describeLiveEvent(event, state)}
                    <small>{new Date(event.created_at).toLocaleTimeString("fr-FR", { hour: "2-digit", minute: "2-digit" })}</small>
                  </span>
                </li>
              ))}
            </ol>
          </aside>
        </section>
      </div>
      {game.status === "finished" && (
        <div className="mt-6 text-center">
          <Button onClick={() => navigate(`/result/${game.id}`)}>
            Voir le resultat <Trophy size={16} />
          </Button>
        </div>
      )}
      <p className="mt-4 text-center text-[10px] text-stone-500">
        Les coups sont valides par le serveur. Les bots jouent automatiquement.
      </p>
    </div>
  );
}

function LiveMultiplayerGame({ game }: { game: Game }) {
  const navigate = useNavigate();
  const [snapshot, setSnapshot] = useState<GameSnapshot | null>(null);
  const [selectedCardId, setSelectedCardId] = useState("");
  const [selectedTargetId, setSelectedTargetId] = useState("");
  const [message, setMessage] = useState("");
  const [turnNotification, setTurnNotification] = useState<{ show: boolean; message: string } | null>(null);
  const wasMyTurnRef = useRef(false);
  const { status: socketStatus, send } = useGameSocket(game.id, {
    onSnapshot: (next) => {
      setSnapshot(next);
      setMessage("");
    },
    onEvent: (_event, next) => {
      setSnapshot(next);
      setMessage("");
    },
    onPresence: (participantId, online) =>
      setSnapshot((current) =>
        current
          ? {
              ...current,
              presence: { ...current.presence, [participantId]: online },
            }
          : current,
      ),
    onError: (_code, detail) => setMessage(detail),
  });

  const state = snapshot?.state ?? null;
  const self = state?.players.find(
    (player) => player.player_id === state.viewer_player_id,
  );
  const activePlayer = state?.players.find(
    (player) => player.player_id === state.active_player_id,
  );
  const opponents =
    state?.players.filter(
      (player) => player.player_id !== state.viewer_player_id,
    ) ?? [];
  const selectedPlays =
    state?.legal_actions.filter(
      (action) => action.card_id === selectedCardId,
    ) ?? [];
  const targetOptions = selectedPlays.filter(
    (action) => action.target_player_id !== null,
  );
  const selectedPlay =
    selectedPlays.find(
      (action) => action.target_player_id === selectedTargetId,
    ) ??
    selectedPlays.find((action) => action.target_player_id === null) ??
    (selectedPlays.length === 1 ? selectedPlays[0] : undefined);
  const canSend = socketStatus === "connected" && game.status === "active";

  // Detect turn changes for multiplayer
  useEffect(() => {
    if (!state) return;
    const isMyTurn = state.active_player_id === state.viewer_player_id && state.phase !== "finished";
    if (isMyTurn && !wasMyTurnRef.current) {
      setTurnNotification({
        show: true,
        message: state.phase === "draw" ? "À vous de piocher !" : state.can_pass ? "Repondez a l'attaque !" : "À vous de jouer !"
      });
      setTimeout(() => setTurnNotification(null), 4000);
    }
    wasMyTurnRef.current = isMyTurn;
  }, [state?.active_player_id, state?.phase, state?.can_pass]);

  function sendAction(action: string, extra: Record<string, unknown> = {}) {
    if (!snapshot) return;
    const sent = send({
      type: "game.action",
      request_id: crypto.randomUUID(),
      state_version: snapshot.game.state_version,
      action,
      ...extra,
    });
    if (!sent) setMessage("Connexion interrompue : reconnexion en cours.");
    else setMessage("");
  }

  function playSelectedCard() {
    if (!selectedCardId || !selectedPlay) {
      setMessage(
        targetOptions.length > 1
          ? "Choisissez un adversaire a cibler."
          : "Cette carte n’est pas jouable dans l’etat actuel.",
      );
      return;
    }
    sendAction("play", {
      card_id: selectedCardId,
      ...(selectedPlay.target_player_id
        ? { target_player_id: selectedPlay.target_player_id }
        : {}),
    });
    setSelectedCardId("");
    setSelectedTargetId("");
  }

  function discardSelectedCard() {
    if (!selectedCardId) {
      setMessage("Selectionnez une carte a defausser.");
      return;
    }
    sendAction("discard", { card_id: selectedCardId });
    setSelectedCardId("");
  }

  function abandonGame() {
    if (!window.confirm("Abandonner cette partie ? La course sera annulee pour tous les joueurs.")) {
      return;
    }
    const sent = send({
      type: "game.abandon",
      request_id: crypto.randomUUID(),
    });
    if (!sent) setMessage("Connexion interrompue : reconnexion en cours.");
  }

  if (!state) {
    return (
      <div className="mx-auto max-w-3xl py-8">
        <div className="game-preview-warning">
          <Radio size={17} className="shrink-0" />
          <p>
            {socketStatus === "error"
              ? "La connexion au serveur de partie a echoue."
              : "Connexion a la partie en temps reel…"}
            {" "}L’etat sera restaure automatiquement apres reconnexion.
          </p>
        </div>
        {message && <div className="mt-4"><Notice tone="error">{message}</Notice></div>}
      </div>
    );
  }

  const currentStatus =
    game.status === "finished"
      ? "Partie terminee"
      : game.status === "cancelled"
        ? "Partie annulee"
        : state.can_pass
          ? "À vous de repondre"
          : state.active_player_id === state.viewer_player_id
            ? state.phase === "draw"
              ? "À vous de piocher"
              : "À vous de jouer"
            : `Au tour de ${activePlayer?.display_name ?? "l’adversaire"}`;

  return (
    <div className="page-enter">
      <div className="mb-5 flex flex-wrap items-center justify-between gap-3">
        <ButtonLink to="/lobby" variant="quiet" className="text-forest">
          <ArrowLeft size={16} /> Retour au lobby
        </ButtonLink>
        <span className={`socket-pill socket-${socketStatus}`}>
          <Radio size={14} />
          {socketStatus === "connected"
            ? "Partie synchronisee"
            : socketStatus === "connecting"
              ? "Reconnexion…"
              : "Hors ligne"}
        </span>
      </div>

      {turnNotification && (
        <div className="turn-change-toast" role="alert" aria-live="polite">
          <span className="turn-change-toast-icon">
            <Radio size={14} />
          </span>
          <span>{turnNotification.message}</span>
        </div>
      )}

      {message && <div className="mb-4"><Notice tone="error">{message}</Notice></div>}
      {game.status === "cancelled" && (
        <div className="mb-4">
          <Notice>La partie a ete annulee apres l’abandon d’un joueur. L’etat reste consultable.</Notice>
        </div>
      )}

      <div className="game-table">
        <header className="game-topbar">
          <div className="flex min-w-0 items-center gap-3">
            <span className="grid size-10 shrink-0 place-items-center rounded-2xl bg-white/10 text-orange-300">
              <Flag size={18} />
            </span>
            <span className="min-w-0">
              <strong className="block truncate font-display text-lg font-extrabold text-cream">
                Mille Bornes · Multijoueur
              </strong>
              <small className="text-xs text-cream/50">
                Tour {state.turn_number} · {state.draw_pile_count} cartes dans la pioche
              </small>
            </span>
          </div>
          <div className="flex items-center gap-3">
            <div className="game-turn-pill">
              <span className="turn-pulse" /> {currentStatus}
            </div>
            {isMyTurn && (
              <span className="my-turn-badge">Votre tour</span>
            )}
          </div>
          {game.status === "active" && (
            <Button
              variant="quiet"
              size="sm"
              className="text-cream/65 hover:bg-white/10 hover:text-cream"
              onClick={abandonGame}
              disabled={!canSend}
            >
              Abandonner
            </Button>
          )}
        </header>
          <div className="flex min-w-0 items-center gap-3">
            <span className="grid size-10 shrink-0 place-items-center rounded-2xl bg-white/10 text-orange-300">
              <Flag size={18} />
            </span>
            <span className="min-w-0">
              <strong className="block truncate font-display text-lg font-extrabold text-cream">
                Mille Bornes · Multijoueur
              </strong>
              <small className="text-xs text-cream/50">
                Tour {state.turn_number} · {state.draw_pile_count} cartes dans la pioche
              </small>
            </span>
          </div>
          <div className="game-turn-pill">
            <span className="turn-pulse" /> {currentStatus}
          </div>
          {game.status === "active" && (
            <Button
              variant="quiet"
              size="sm"
              className="text-cream/65 hover:bg-white/10 hover:text-cream"
              onClick={abandonGame}
              disabled={!canSend}
            >
              Abandonner
            </Button>
          )}
        </header>

        <section className="opponent-board" aria-label="État visible des adversaires">
          {opponents.map((opponent, index) => {
            const isOnline = snapshot?.presence[opponent.player_id] ?? false;
            return (
              <OpponentBoardCard
                key={opponent.player_id}
                player={opponent}
                index={index}
                online={isOnline}
                active={opponent.player_id === state.active_player_id}
              />
            );
          })}
          <div className="opponent-note">
            <span className="grid size-8 place-items-center rounded-xl bg-white/8 text-orange-300">
              <Sparkles size={15} />
            </span>
            <span>
              <strong>En direct</strong>
              <small>État autoritaire du serveur</small>
            </span>
          </div>
        </section>

        <section className="road-board" aria-label="État de la course">
          <div className="road-board-top">
            <span className="flex items-center gap-2 text-xs font-bold uppercase tracking-[.14em] text-cream/55">
              <Gauge size={15} /> La route
            </span>
            <span className="text-xs font-semibold text-cream/45">
              Objectif · {state.target_distance.toLocaleString("fr-FR")} km
            </span>
          </div>
          <div className="road-progress-wrap">
            <div className="road-progress-label">
              <span>{self?.display_name ?? "Vous"}</span>
              <strong>{self?.distance ?? 0} <small>km</small></strong>
            </div>
            <div className="road-track">
              <span
                className="road-track-fill"
                style={{
                  width: `${Math.min(
                    100,
                    ((self?.distance ?? 0) / state.target_distance) * 100,
                  )}%`,
                }}
              />
              <span
                className="road-car-marker"
                style={{
                  left: `${Math.min(
                    97,
                    ((self?.distance ?? 0) / state.target_distance) * 100,
                  )}%`,
                }}
              >
                🚙
              </span>
              <span className="road-finish-marker">
                <Flag size={13} /> {state.target_distance}
              </span>
            </div>
            <div className="road-ticks">
              <span>0 km</span>
              <span>{Math.round(state.target_distance / 2)} km</span>
              <span>{state.target_distance} km</span>
            </div>
          </div>
          <div className="road-boards">
            <BattleBoard
              title="Votre route"
              icon={<ShieldCheck size={15} />}
              status={self?.green_light_card ? "Feu vert" : "À l’arret"}
              tone={self?.green_light_card ? "good" : "neutral"}
              card={self?.green_light_card}
            />
            <BattleBoard
              title="Danger actif"
              icon={<Gauge size={15} />}
              status={
                self?.battle_attack
                  ? cardLabel(self.battle_attack.card_type)
                  : self?.speed_attack
                    ? cardLabel(self.speed_attack.card_type)
                    : "Aucun"
              }
              tone={self?.battle_attack || self?.speed_attack ? "neutral" : "good"}
              card={self?.battle_attack ?? self?.speed_attack}
            />
            <BattleBoard
              title="Bottes actives"
              icon={<Sparkles size={15} />}
              status={self?.safeties.length ? self.safeties.map(cardLabel).join(" · ") : "Aucune"}
              tone={self?.safeties.length ? "good" : "neutral"}
            />
          </div>
          <div className="mt-3 flex flex-wrap items-center gap-2">
            <span className="text-[9px] font-bold uppercase tracking-wider text-cream/40">
              Bornes posees
            </span>
            {self?.distance_cards.map((card) => (
              <GameCard
                key={card.id}
                type={card.card_type}
                size="small"
                className="scale-[.55] origin-left -mr-8"
              />
            ))}
            {state.discard_top && (
              <>
                <span className="ml-auto text-[9px] font-bold uppercase tracking-wider text-cream/40">
                  Defausse
                </span>
                <GameCard type={state.discard_top.card_type} size="small" className="scale-[.55] origin-right -mr-8" />
              </>
            )}
          </div>
        </section>

        <section className="game-bottom">
          <div className="game-hand-panel">
            <div className="flex flex-wrap items-center justify-between gap-3">
              <div>
                <p className="eyebrow text-cream/45">Votre main</p>
                <h2 className="mt-1 font-display text-lg font-extrabold text-cream">
                  {state.can_draw
                    ? "Piochez pour commencer votre tour"
                    : state.can_pass
                      ? "Repondez a l’attaque"
                      : "Choisissez une carte"}
                </h2>
              </div>
              <span className="rounded-full bg-white/8 px-3 py-1 text-[10px] font-bold text-cream/55">
                {state.hand.length} cartes
              </span>
            </div>
            <div className="game-hand">
              {state.hand.map((card) => {
                const playable = state.legal_actions.some(
                  (action) => action.card_id === card.id,
                );
                const isPlayableNow = isMyTurn && playable;
                return (
                  <GameCard
                    key={card.id}
                    type={card.card_type}
                    selected={selectedCardId === card.id}
                    disabled={!playable && !state.can_discard}
                    className={isPlayableNow ? "playable-card-highlight" : undefined}
                    onClick={() => {
                      setSelectedCardId(card.id);
                      setSelectedTargetId("");
                      setMessage("");
                    }}
                  />
                );
              })}
            </div>
            {targetOptions.length > 0 && (
              <label className="mt-4 flex flex-wrap items-center gap-3 text-xs font-bold text-cream/70">
                Cible de l’attaque
                <select
                  className="rounded-xl border border-white/15 bg-forest-950 px-3 py-2 text-sm text-cream"
                  value={selectedTargetId}
                  onChange={(event) => setSelectedTargetId(event.target.value)}
                >
                  <option value="">Choisir un joueur</option>
                  {targetOptions.map((action) => {
                    const target = state.players.find(
                      (player) => player.player_id === action.target_player_id,
                    );
                    return (
                      <option key={action.target_player_id} value={action.target_player_id ?? ""}>
                        {target?.display_name ?? "Adversaire"}
                      </option>
                    );
                  })}
                </select>
              </label>
            )}
            <div className="mt-5 flex flex-wrap items-center gap-3">
              {state.can_draw && (
                <Button disabled={!canSend} onClick={() => sendAction("draw")}>
                  Piocher
                </Button>
              )}
              <Button
                disabled={!canSend || !selectedPlay}
                onClick={playSelectedCard}
              >
                Jouer la carte <ArrowRight size={16} />
              </Button>
              {state.can_discard && (
                <Button
                  variant="outline"
                  className="border-white/15 bg-white/5 text-cream hover:bg-white/10"
                  disabled={!canSend || !selectedCardId}
                  onClick={discardSelectedCard}
                >
                  <Trash2 size={15} /> Defausser
                </Button>
              )}
              {state.can_pass && (
                <Button
                  variant="outline"
                  className="border-white/15 bg-white/5 text-cream hover:bg-white/10"
                  disabled={!canSend}
                  onClick={() => sendAction("pass")}
                >
                  Passer
                </Button>
              )}
            </div>
          </div>
          <aside className="game-log-panel">
            <div className="flex items-center justify-between">
              <span className="flex items-center gap-2 text-sm font-extrabold text-cream">
                <History size={16} /> Actions recentes
              </span>
              <span className="text-[9px] font-bold uppercase tracking-wider text-cream/35">
                En direct
              </span>
            </div>
            <ol className="mt-4 space-y-4">
              {[...(snapshot?.events ?? [])].reverse().slice(0, 8).map((event) => (
                <li className="game-log-item" key={event.id}>
                  <span className={`game-log-dot ${event.event_type === "game.action" ? "active" : ""}`} />
                  <span>
                    {describeLiveEvent(event, state)}
                    <small>{new Date(event.created_at).toLocaleTimeString("fr-FR", { hour: "2-digit", minute: "2-digit" })}</small>
                  </span>
                </li>
              ))}
            </ol>
          </aside>
        </section>
      </div>
      {game.status === "finished" && (
        <div className="mt-6 text-center">
          <Button onClick={() => navigate(`/result/${game.id}`)}>
            Voir le resultat <Trophy size={16} />
          </Button>
        </div>
      )}
      <p className="mt-4 text-center text-[10px] text-stone-500">
        Les coups sont valides par le serveur. Les mains adverses restent cachees.
      </p>
    </div>
  );
}

function OpponentBoardCard({
  player,
  index,
  online,
  active,
}: {
  player: VisiblePlayerState;
  index: number;
  online: boolean;
  active: boolean;
}) {
  const visibleCards = [player.battle_attack, player.speed_attack].filter(
    (card): card is EngineCard => card !== null,
  );
  return (
    <article className="opponent-board-card">
      <div className="flex items-center gap-3">
        <span className={`opponent-avatar opponent-avatar-${index % 2}`}>
          {player.display_name.slice(0, 1).toUpperCase()}
        </span>
        <span className="min-w-0">
          <strong className="block truncate text-sm text-cream">
            {player.display_name}
          </strong>
          <small className="flex items-center gap-1.5 text-[10px] text-cream/45">
            <span className={`size-1.5 rounded-full ${online ? "bg-emerald-400" : "bg-stone-500"}`} />
            {active ? "Joueur actif" : online ? "En ligne" : "Deconnecte"}
          </small>
        </span>
      </div>
      <div className="opponent-km"><strong>{player.distance}</strong><span>km</span></div>
      <div className="mt-3 flex items-center justify-between gap-2">
        <div className="flex -space-x-5">
          {visibleCards.map((card) => (
            <GameCard
              key={card.id}
              type={card.card_type}
              size="small"
              className="scale-[.62] origin-top-left -mr-7"
            />
          ))}
          {Array.from({ length: Math.min(3, player.hand_count) }).map((_, cardIndex) => (
            <GameCard
              key={`hidden-${cardIndex}`}
              back
              size="small"
              className="scale-[.62] origin-top-left -mr-7"
            />
          ))}
        </div>
        <span className="text-[9px] font-bold uppercase tracking-wider text-cream/40">
          {player.hand_count} cachees
        </span>
      </div>
    </article>
  );
}

function cardLabel(type: string): string {
  const labels: Record<string, string> = {
    km_25: "25 km",
    km_50: "50 km",
    km_75: "75 km",
    km_100: "100 km",
    km_200: "200 km",
    speed_limit: "Limitation",
    red_light: "Feu rouge",
    out_of_fuel: "Panne d’essence",
    flat_tire: "Crevaison",
    accident: "Accident",
    green_light: "Feu vert",
    end_speed_limit: "Fin de limitation",
    fuel: "Essence",
    spare_tire: "Roue de secours",
    repairs: "Reparations",
    priority_vehicle: "Vehicule prioritaire",
    extra_tank: "Citerne",
    puncture_proof: "Increvable",
    driving_ace: "As du volant",
  };
  return labels[type] ?? type;
}

function describeLiveEvent(
  event: LiveGameEvent,
  state: LiveGameState,
): string {
  const rawEvents = event.data.events;
  if (Array.isArray(rawEvents)) {
    const messages = rawEvents.map((rawEvent) => {
      if (!rawEvent || typeof rawEvent !== "object") return "";
      const item = rawEvent as Record<string, unknown>;
      const actor = state.players.find(
        (player) => player.player_id === item.actor_player_id,
      )?.display_name ?? (event.actor_display_name || "Un joueur");
      const target = state.players.find(
        (player) => player.player_id === item.target_player_id,
      )?.display_name ?? "un adversaire";
      const card = typeof item.card_type === "string" ? cardLabel(item.card_type) : "";
      switch (item.event_type) {
        case "distance.played":
          return `${actor} avance de ${card}.`;
        case "attack.played":
          return `${actor} attaque ${target}${card ? ` avec ${card}` : ""}.`;
        case "card.drawn":
          return `${actor} pioche une carte.`;
        case "card.discarded":
          return `${actor} defausse${card ? ` ${card}` : " une carte"}.`;
        case "safety.played":
          return `${actor} joue une botte${card ? ` : ${card}` : ""}.`;
        case "parade.played":
          return `${actor} repare${card ? ` avec ${card}` : ""}.`;
        case "coup_fourre.played":
          return `${actor} realise un Coup-Fourre !`;
        default:
          return actor;
      }
    }).filter(Boolean);
    if (messages.length) return messages.join(" ");
  }
  const messages: Record<string, string> = {
    "game.started": "La course commence.",
    "game.finished": "La course est terminee.",
    "player.joined": `${event.actor_display_name} rejoint la course.`,
    "player.ready_changed": `${event.actor_display_name} a modifie son statut.`,
    "player.abandoned": `${event.actor_display_name} a abandonne la partie.`,
    "host.changed": "L’hote du salon a change.",
  };
  return messages[event.event_type] ?? event.actor_display_name;
}

function BattleBoard({
  title,
  icon,
  status,
  tone,
  card,
}: {
  title: string;
  icon: ReactNode;
  status: string;
  tone: "good" | "neutral";
  card?: EngineCard | null;
}) {
  return (
    <div className="battle-board">
      <span className="flex items-center gap-1.5 text-[9px] font-bold uppercase tracking-wider text-cream/40">{icon}{title}</span>
      <strong className={tone === "good" ? "text-emerald-300" : "text-cream"}>{status}</strong>
      {card && <GameCard type={card.card_type} size="small" className="scale-[.48] origin-right -mr-10 -mt-9" />}
    </div>
  );
}
