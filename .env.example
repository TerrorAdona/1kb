# Mille Bornes - Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# =============================================================================
# DJANGO SETTINGS
# =============================================================================
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here-min-50-chars

# Set to 'true' for development, 'false' for production
DJANGO_DEBUG=false

# Comma-separated list of allowed hosts
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,yourdomain.com

# Timezone for the application
DJANGO_TIME_ZONE=Africa/Johannesburg

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# DATABASE (POSTGRESQL)
# =============================================================================
POSTGRES_DB=millebornes
POSTGRES_USER=millebornes
# Generate a secure password: openssl rand -base64 32
POSTGRES_PASSWORD=your-secure-postgres-password-here

# =============================================================================
# REDIS
# =============================================================================
# Redis URL for cache and channels (Docker service name: redis)
REDIS_URL=redis://redis:6379/0

# =============================================================================
# CORS & CSRF (FRONTEND ORIGINS)
# =============================================================================
# Comma-separated list of frontend origins
FRONTEND_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# CSRF trusted origins (must match FRONTEND_ORIGINS for HTTPS)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Cookie security settings (true for HTTPS production)
CSRF_COOKIE_SECURE=true
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=true

# =============================================================================
# JWT SETTINGS
# =============================================================================
JWT_REFRESH_COOKIE_SECURE=true
JWT_REFRESH_COOKIE_SAMESITE=Lax
# Optional: set cookie domain for subdomain sharing
# JWT_REFRESH_COOKIE_DOMAIN=.yourdomain.com

# =============================================================================
# EMAIL (OPTIONAL - for password reset, notifications)
# =============================================================================
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=Mille Bornes <noreply@yourdomain.com>

# =============================================================================
# SENTRY (OPTIONAL - error tracking)
# =============================================================================
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# =============================================================================
# SSL/HTTPS (FOR NGINX)
# =============================================================================
# Place your SSL certificates in ./nginx/ssl/
# cert.pem - SSL certificate
# key.pem - SSL private key
# Generate self-signed for development:
# openssl req -x509 -nodes -days 365 -newkey rsa:2048 -keyout nginx/ssl/key.pem -out nginx/ssl/cert.pem -subj "/CN=localhost"