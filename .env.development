# Mille Bornes - Development Environment Variables
# This file is for LOCAL DEVELOPMENT ONLY
# Copy to .env for local development

# =============================================================================
# DJANGO SETTINGS
# =============================================================================
DJANGO_SECRET_KEY=dev-secret-key-change-in-production-minimum-50-characters-long
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,frontend
DJANGO_TIME_ZONE=Africa/Johannesburg
LOG_LEVEL=DEBUG

# =============================================================================
# DATABASE (POSTGRESQL)
# =============================================================================
POSTGRES_DB=millebornes
POSTGRES_USER=millebornes
POSTGRES_PASSWORD=millebornes-dev-password-change-in-production

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# CORS & CSRF (FRONTEND ORIGINS)
# =============================================================================
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

# =============================================================================
# JWT SETTINGS
# =============================================================================
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SAMESITE=Lax